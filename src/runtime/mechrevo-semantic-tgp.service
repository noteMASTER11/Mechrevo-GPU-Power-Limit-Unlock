[Unit]
Description=Semantic NVIDIA GSP TGP resolver V11
ConditionKernelCommandLine=codex.semantic_tgp=250-v11
After=nvidia-persistenced.service uccd.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/mechrevo-semantic-tgp/mechrevo-semantic-tgp
RemainAfterExit=yes
Restart=no
TimeoutStartSec=0
UMask=0077
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
