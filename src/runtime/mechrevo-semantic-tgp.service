[Unit]
Description=Mechrevo semantic GSP TGP resolver
ConditionKernelCommandLine=codex.semantic_tgp=250-v8r6
After=nvidia-powerd.service nvidia-persistenced.service uccd.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/mechrevo-semantic-tgp/mechrevo-semantic-tgp
RemainAfterExit=yes
Restart=no
TimeoutStartSec=0
UMask=0077
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
