[Unit]
Description=Mechrevo boot-scoped 225 W GSP policy experiment
ConditionKernelCommandLine=codex.max_tgp=225
After=uccd.service nvidia-persistenced.service
[Service]
Type=oneshot
ExecStart=/usr/bin/python /usr/local/lib/mechrevo-max-tgp/run_boot.py activate
RemainAfterExit=yes
Restart=no
TimeoutStartSec=0
UMask=0077
[Install]
WantedBy=multi-user.target
