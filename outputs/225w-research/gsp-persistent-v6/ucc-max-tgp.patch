+bool UccDBusInterfaceAdaptor::SetMaxTGP(bool enabled)
+{
+  if (!checkAuth(PolkitAuthority::ACTION_CONTROL) || !m_service) return false;
+  auto &ownership = GpuPowerOwnership::instance();
+  if (ownership.forced()) return false;
+  const bool previous = m_service->m_settings.maxTGP;
+  // Quiesce the writers before persisting an enabled mode.
+  if (enabled) ownership.setEnabled(true);
+  m_service->m_settings.maxTGP = enabled;
+  if (!m_service->m_settingsManager.writeSettings(m_service->m_settings)) {
+    m_service->m_settings.maxTGP = previous;
+    ownership.setEnabled(previous);
+    return false;
+  }
+  ownership.setEnabled(enabled);
+  m_service->updateDBusSettingsData();
+  if (!enabled) m_service->applyCTGPFromProfile(m_service->m_activeProfile);
+  return true;
+}
