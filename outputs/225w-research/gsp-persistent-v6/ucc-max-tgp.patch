diff --git a/tests/test_gpu_power_ownership.cpp b/tests/test_gpu_power_ownership.cpp
new file mode 100644
index 0000000..225cc09
--- /dev/null
+++ b/tests/test_gpu_power_ownership.cpp
@@ -0,0 +1,36 @@
+#include <cassert>
+#include <future>
+#include <thread>
+#include "GpuPowerOwnership.hpp"
+int main() {
+  GpuPowerOwnership normal("");
+  int writes = 0;
+  assert(normal.write([&] { ++writes; return true; }));
+  assert(normal.setEnabled(true));
+  assert(!normal.write([&] { ++writes; return true; }));
+  assert(writes == 1);
+  assert(normal.setEnabled(false));
+  assert(normal.write([&] { ++writes; return true; }));
+  GpuPowerOwnership forced("quiet codex.max_tgp=225 splash");
+  assert(forced.forced() && forced.enabled());
+  assert(!forced.setEnabled(false));
+  assert(!forced.write([&] { ++writes; return true; }));
+  for (const char *token : {"codex.max_tgp=2250", "xcode codex.max_tgp=200", "xcodex.max_tgp=225"}) {
+    GpuPowerOwnership other(token);
+    assert(!other.enabled());
+  }
+  // An in-flight write must finish before enabling returns.
+  GpuPowerOwnership concurrent("");
+  std::promise<void> entered, release;
+  auto released = release.get_future();
+  auto writer = std::async(std::launch::async, [&] {
+    return concurrent.write([&] { entered.set_value(); released.wait(); return true; });
+  });
+  entered.get_future().wait();
+  auto toggle = std::async(std::launch::async, [&] { return concurrent.setEnabled(true); });
+  assert(toggle.wait_for(std::chrono::milliseconds(30)) == std::future_status::timeout);
+  release.set_value();
+  assert(writer.get());
+  assert(toggle.get());
+  assert(!concurrent.write([] { return true; }));
+}
diff --git a/tests/test_nvml_power_ownership.cpp b/tests/test_nvml_power_ownership.cpp
new file mode 100644
index 0000000..df3f3da
--- /dev/null
+++ b/tests/test_nvml_power_ownership.cpp
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "NvmlWrapper.hpp"
+#include "GpuPowerOwnership.hpp"
+#include <cassert>
+#include <dlfcn.h>
+int main()
+{
+  void *fake = dlopen("libnvidia-ml.so.1", RTLD_NOW);
+  assert(fake);
+  auto count = reinterpret_cast<unsigned (*)()>(dlsym(fake, "testWriteCount"));
+  auto fail = reinterpret_cast<void (*)()>(dlsym(fake, "testFailRequestedRead"));
+  assert(count && fail); // Never exercise the real driver in this test.
+  NvmlWrapper nvml(false);
+  assert(nvml.isAvailable());
+  assert(nvml.getRequestedPowerLimitW(0) == 225.0);
+  assert(nvml.getEnforcedPowerLimitW(0) == 200.0);
+  auto &ownership = GpuPowerOwnership::instance();
+  assert(ownership.setEnabled(true));
+  assert(!nvml.setPowerLimit(0, 100000));
+  assert(!nvml.resetPowerLimit(0));
+  assert(count() == 0);
+  assert(nvml.getRequestedPowerLimitW(0) == 225.0);
+  fail();
+  assert(!nvml.getRequestedPowerLimitW(0));
+  assert(nvml.getEnforcedPowerLimitW(0) == 200.0);
+  assert(ownership.setEnabled(false));
+  assert(nvml.setPowerLimit(0, 100000));
+  assert(nvml.resetPowerLimit(0));
+  assert(count() == 2);
+  dlclose(fake);
+}
