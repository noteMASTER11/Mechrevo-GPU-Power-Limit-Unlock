+void ucc::MainWindow::refreshGPUPowerStatus()
+{
+  if (m_gpuPowerReadPending) return;
+  m_gpuPowerReadPending = true;
+  const auto generation = m_gpuPowerReadGeneration;
+  ucc::readUccdAsync(this, "GetGPUPowerStatusJSON", {}, [this, generation](std::optional<QVariant> result) {
+    m_gpuPowerReadPending = false;
+    if (generation != m_gpuPowerReadGeneration) {
+      refreshGPUPowerStatus();
+      return;
+    }
+    const auto obj = result ? QJsonDocument::fromJson(result->toString().toUtf8()).object() : QJsonObject{};
+    m_gpuPowerStatusKnown = obj.value("enabled").isBool() && obj.value("forced").isBool();
+    m_gpuPowerSystemOwned = obj.value("enabled").toBool();
+    const bool forced = obj.value("forced").toBool();
+    const QSignalBlocker blocker(m_maxTGPCheckBox);
+    m_maxTGPCheckBox->setChecked(m_gpuPowerStatusKnown && m_gpuPowerSystemOwned);
+    m_maxTGPCheckBox->setEnabled(m_gpuPowerStatusKnown && !forced);
+    m_maxTGPCheckBox->setToolTip(forced
+      ? "System-owned GPU power is forced by codex.max_tgp=225 for this boot. Boot normally to change it. This does not confirm 225 W."
+      : "Let the system own GPU power limits. UCC stops cTGP and GPU power-limit writes. This does not increase power or confirm 225 W.");
+    m_ctgpSlider->setEnabled(m_gpuPowerEditable && m_gpuPowerStatusKnown && !m_gpuPowerSystemOwned);
+    auto watts = [&](const char *key) {
+      const auto value = obj.value(key);
+      return value.isDouble() ? QString::number(value.toDouble(), 'f', 1) + " W" : QString("unavailable");
+    };
+    m_gpuPowerStatus->setText("Requested: " + watts("requestedW") + " | Enforced: " + watts("enforcedW") + " | cTGP offset: " + watts("ctgpOffsetW"));
+  });
+}
diff --git a/uccd/inc/GpuPowerOwnership.hpp b/uccd/inc/GpuPowerOwnership.hpp
new file mode 100644
index 0000000..c7dc8a8
--- /dev/null
+++ b/uccd/inc/GpuPowerOwnership.hpp
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <fstream>
+#include <mutex>
+#include <sstream>
+#include <string>
+
+// All GPU power writers share this lock. Once enabling returns, even an
+// already-running write has completed and no later UCC write can start.
+class GpuPowerOwnership
+{
+public:
+  explicit GpuPowerOwnership(const std::string &cmdline) {
+    std::istringstream tokens(cmdline);
+    for (std::string token; tokens >> token;)
+      if (token == "codex.max_tgp=225") m_forced = true;
+  }
+  static GpuPowerOwnership &instance() {
+    static GpuPowerOwnership state([] {
+      std::ifstream input("/proc/cmdline");
+      std::string line;
+      std::getline(input, line);
+      return line;
+    }());
+    return state;
+  }
+  bool forced() const { return m_forced; }
+  bool enabled() const {
+    std::lock_guard lock(m_mutex);
+    return m_forced || m_enabled;
+  }
+  bool setEnabled(bool enabled) {
+    std::lock_guard lock(m_mutex);
+    if (m_forced && !enabled) return false;
+    m_enabled = enabled;
+    return true;
+  }
+  template<class Writer> bool write(Writer writer) {
+    std::lock_guard lock(m_mutex);
+    if (m_forced || m_enabled) return false;
+    return writer();
+  }
+private:
+  mutable std::mutex m_mutex;
+  bool m_enabled = false;
+  bool m_forced = false;
+};
