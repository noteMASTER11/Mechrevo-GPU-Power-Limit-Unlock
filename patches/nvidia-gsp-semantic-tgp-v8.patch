new file mode 100644
index 0000000..17ab2e1
--- /dev/null
+++ b/research/semantic_resolver.py
@@ -0,0 +1,283 @@
+#!/usr/bin/env python3
+"""Fail-closed semantic resolver for the GSP-RM power-policy graph.
+
+This is the executable reference model for the in-kernel resolver.  It does
+not accept object addresses or member offsets.  The public policy description
+is the oracle for policy identity and numeric bounds; all private heap
+locations are inferred from the current heap image.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, asdict
+import struct
+
+POLICY_COUNT = 20
+MAX_HEAP_SIZE = 256 * 1024 * 1024
+MAX_OBJECT_PREFIX = 0x1000
+MAX_IDENTITY_PREFIX = 0x80
+
+
+class ResolveError(RuntimeError):
+    pass
+
+
+@dataclass(frozen=True)
+class PublicPolicy:
+    index: int
+    policy_type: int
+    policy_id: int
+    unit: int
+    lower: int
+    upper: int
+
+
+@dataclass(frozen=True)
+class Resolution:
+    va_base: int
+    policy_array: int
+    board_object: int
+    selector: int
+    ctgp_tuple: int
+    index_member: int
+    type_member: int
+    id_member: int
+    unit_member: int
+    board_max_effective: int
+    board_max_source: int
+    pmgr_upper: int
+    stock_upper_mw: int
+    current_upper_mw: int
+
+    def as_dict(self):
+        return asdict(self)
+
+
+def parse_public_fixture(blob: bytes) -> tuple[int, list[PublicPolicy]]:
+    """Decode the captured A618 ABI for tests.
+
+    Production code gets these fields from the matching NVIDIA control
+    structure, so this fixture adapter is deliberately kept out of the core.
+    """
+    if len(blob) < 0xCC + POLICY_COUNT * 0x104:
+        raise ResolveError("public policy response is truncated")
+    mask = struct.unpack_from("<I", blob, 4)[0]
+    if mask >> POLICY_COUNT:
+        raise ResolveError("public policy mask has unsupported high bits")
+    policies = []
+    for index in range(POLICY_COUNT):
+        off = 0xCC + index * 0x104
+        if mask & (1 << index):
+            policy_type, policy_id, unit = blob[off + 4 : off + 7]
+            lower, upper = struct.unpack_from("<II", blob, off + 12)
+            if lower > upper:
+                raise ResolveError(f"public policy {index} has inverted bounds")
+            policies.append(PublicPolicy(index, policy_type, policy_id, unit, lower, upper))
+        elif any(blob[off : off + 0x20]):
+            raise ResolveError(f"inactive public policy {index} is not empty")
+    if not policies or not any(p.index == 2 for p in policies):
+        raise ResolveError("public board-power policy 2 is absent")
+    return mask, policies
+
+
+def resolve(heap: bytes, mask: int, policies: list[PublicPolicy]) -> Resolution:
+    if not 0x10000 <= len(heap) <= MAX_HEAP_SIZE:
+        raise ResolveError("heap size is outside the bounded resolver range")
+    if mask != sum(1 << p.index for p in policies):
+        raise ResolveError("public mask and policy list disagree")
+    by_index = {p.index: p for p in policies}
+    if len(by_index) != len(policies) or 2 not in by_index:
+        raise ResolveError("public policy identities are incomplete")
+    board_public = by_index[2]
+
+    def u16(off: int) -> int:
+        return struct.unpack_from("<H", heap, off)[0]
+
+    def u32(off: int) -> int:
+        return struct.unpack_from("<I", heap, off)[0]
+
+    def u64(off: int) -> int:
+        return struct.unpack_from("<Q", heap, off)[0]
+
+    # A selector is described by behavior, source identity and the public
+    # stock ceiling.  Its location relative to an object is not assumed.
+    selectors = []
+    for off in range(0, len(heap) - 20, 4):
+        effective = u32(off + 4)
+        if (heap[off] == 0 and heap[off + 1] == 1 and
+                u32(off + 8) == board_public.upper and
+                heap[off + 12] == 0xFE and u32(off + 16) == effective and
+                board_public.upper <= effective <= 400_000):
+            selectors.append(off)
+    if not selectors:
+        raise ResolveError("no semantic board ceiling selector")
+
+    # Locate policy pointer arrays by their public active mask.  Pointer
+    # values are not interpreted until a VA base is inferred from policy 2.
+    active = [p.index for p in policies]
+    inactive = [i for i in range(POLICY_COUNT) if not mask & (1 << i)]
+    arrays = []
+    span = POLICY_COUNT * 8
+    for off in range(0, len(heap) - span + 1, 8):
+        if any(u64(off + i * 8) != 0 for i in inactive):
+            continue
+        pointers = [u64(off + i * 8) for i in active]
+        if any(p == 0 or p & 7 for p in pointers):
+            continue
+        if max(pointers) - min(pointers) >= len(heap):
+            continue
+        arrays.append(off)
+    if not arrays:
+        raise ResolveError("no policy-array shape matches the public mask")
+
+    resolutions = []
+    for selector in selectors:
+        first_board = max(0, selector - MAX_OBJECT_PREFIX)
+        for array in arrays:
+            board_va = u64(array + 2 * 8)
+            for board in range((first_board + 7) & ~7, selector + 1, 8):
+                va_base = board_va - board
+                if va_base <= 0 or va_base & 0xFFF:
+                    continue
+                objects = {}
+                valid = True
+                for p in policies:
+                    ptr = u64(array + p.index * 8)
+                    if ptr < va_base or ptr - va_base >= len(heap):
+                        valid = False
+                        break
+                    objects[p.index] = ptr - va_base
+                if not valid or objects[2] != board:
+                    continue
+
+                # Discover each identity member independently and require a
+                # unique common offset across every active policy object.
+                index_members = []
+                type_members = []
+                id_members = []
+                unit_members = []
+                for member in range(MAX_IDENTITY_PREFIX):
+                    if all(o + member < len(heap) for o in objects.values()):
+                        if all(heap[o + member] == p.index for p in policies for o in [objects[p.index]]):
+                            index_members.append(member)
+                        if all(heap[o + member] == p.policy_type for p in policies for o in [objects[p.index]]):
+                            type_members.append(member)
+                        if all(heap[o + member] == p.policy_id for p in policies for o in [objects[p.index]]):
+                            id_members.append(member)
+                        if all(heap[o + member] == p.unit for p in policies for o in [objects[p.index]]):
+                            unit_members.append(member)
+                if not all(len(x) == 1 for x in (index_members, type_members, id_members, unit_members)):
+                    continue
+                members = (index_members[0], type_members[0], id_members[0], unit_members[0])
+                if len(set(members)) != 4:
+                    continue
+                # Index is stored as a word in the observed class hierarchy;
+                # checking the upper byte prevents a byte-sized false match.
+                if any(u16(objects[p.index] + members[0]) != p.index for p in policies):
+                    continue
+
+                # The selected record must belong to the uniquely identified
+                # board policy object, without assuming its relative offset.
+                if not board <= selector < min(len(heap), board + MAX_OBJECT_PREFIX):
+                    continue
+
+                # cTGP data is linked semantically to public policy 2 bounds.
+                ctgp = []
+                for q in range(0, len(heap) - 12, 4):
+                    upper = u32(q + 8)
+                    if (u32(q) == 2 and u32(q + 4) == board_public.lower and
+                            board_public.upper <= upper <= 400_000):
+                        ctgp.append(q)
+                if len(ctgp) != 1:
+                    continue
+
+                resolutions.append(Resolution(
+                    va_base=va_base, policy_array=array, board_object=board,
+                    selector=selector, ctgp_tuple=ctgp[0],
+                    index_member=members[0], type_member=members[1],
+                    id_member=members[2], unit_member=members[3],
+                    board_max_effective=selector + 4,
+                    board_max_source=selector + 16,
+                    pmgr_upper=ctgp[0] + 8,
+                    stock_upper_mw=board_public.upper,
+                    current_upper_mw=u32(ctgp[0] + 8)))
+
+    # Deduplicate candidates reached through equivalent scan paths.
+    unique = list(dict.fromkeys(resolutions))
+    if len(unique) != 1:
+        raise ResolveError(f"semantic topology count is {len(unique)}, expected exactly 1")
+    return unique[0]
+
+
+def resolve_autonomous(heap: bytes) -> Resolution:
+    """Resolve from private heap semantics alone.
+
+    This is the primary model.  It accepts no stock wattage, object address,
+    member offset, public-policy ABI blob or driver-version selector.
+    """
+    if not 0x10000 <= len(heap) <= MAX_HEAP_SIZE:
+        raise ResolveError("heap size is outside the bounded resolver range")
+    size = len(heap)
+    u16 = lambda o: struct.unpack_from('<H', heap, o)[0]
+    u32 = lambda o: struct.unpack_from('<I', heap, o)[0]
+    u64 = lambda o: struct.unpack_from('<Q', heap, o)[0]
+    selectors = []
+    tuples = []
+    for off in range(0, size - 20, 4):
+        effective, default, source_value = u32(off + 4), u32(off + 8), u32(off + 16)
+        if (heap[off] == 0 and heap[off + 1] == 1 and heap[off + 12] == 0xFE and
+                effective == source_value and 20_000 <= default <= effective <= 400_000):
+            selectors.append((off, effective, default))
+        first = u32(off)
+        if first == 2 and 20_000 <= effective <= default <= 400_000:
+            tuples.append((off, effective, default))
+    if not selectors or not tuples:
+        raise ResolveError("selector/cTGP semantics are absent")
+    selector_values = {v for _o, effective, default in selectors for v in (effective, default)}
+    tuples = [x for x in tuples if x[1] in selector_values and x[2] in selector_values]
+    if not tuples:
+        raise ResolveError("no cTGP tuple is linked to selector defaults")
+
+    found = []
+    for array in range(0, size - POLICY_COUNT * 8 + 1, 8):
+        raw = [u64(array + i * 8) for i in range(POLICY_COUNT)]
+        pointers = [p for p in raw if p]
+        if (len(pointers) < 8 or not raw[2] or any(p & 7 for p in pointers) or
+                max(pointers) - min(pointers) >= size):
+            continue
+        for selector, _effective, upper in selectors:
+            first = max(0, selector - MAX_OBJECT_PREFIX)
+            board = (first & ~0xFFF) | (raw[2] & 0xFFF)
+            if board < first:
+                board += 0x1000
+            while board <= selector:
+                va_base = raw[2] - board
+                if va_base > 0 and not va_base & 0xFFF:
+                    objects = {i: p - va_base for i, p in enumerate(raw) if p}
+                    if (objects.get(2) == board and
+                            all(0 <= o < size for o in objects.values())):
+                        index_members = [m for m in range(MAX_IDENTITY_PREFIX)
+                                         if all(heap[o + m] == i for i, o in objects.items())]
+                        if (len(index_members) == 1 and
+                                all(u16(o + index_members[0]) == i for i, o in objects.items())):
+                            links = []
+                            for ctgp, lower, tuple_upper in tuples:
+                                if tuple_upper != _effective:
+                                    continue
+                                lower_selectors = [s for s, _e, d in selectors
+                                                   if (d == lower or _e == lower) and board <= s < board + MAX_OBJECT_PREFIX]
+                                if len(lower_selectors) == 1:
+                                    links.append((ctgp, lower_selectors[0]))
+                            if len(links) == 1:
+                                ctgp, lower_selector = links[0]
+                                found.append(Resolution(
+                                    va_base, array, board, selector, ctgp,
+                                    index_members[0], -1, -1, -1,
+                                    selector + 4, selector + 16, ctgp + 8,
+                                    upper, u32(ctgp + 8)))
+                                # Python dataclass predates lower_selector; the
+                                # C production result retains it explicitly.
+                board += 0x1000
+    unique = list(dict.fromkeys(found))
+    if len(unique) != 1:
+        raise ResolveError(f"autonomous semantic topology count is {len(unique)}, expected exactly 1")
+    return unique[0]
