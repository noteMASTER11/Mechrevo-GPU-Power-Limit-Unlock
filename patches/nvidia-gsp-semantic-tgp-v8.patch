+#include "semantic_core.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct image { unsigned char *p; size_t n; };
+static int image_read(void *opaque,uint64_t off,void *dst,uint32_t n){
+    struct image *x=opaque;if(off>x->n||n>x->n-off)return 1;memcpy(dst,x->p+off,n);return 0;
+}
+static unsigned char *load(const char *name,size_t *size){
+    FILE *f=fopen(name,"rb");unsigned char *p;long n;if(!f)return NULL;
+    fseek(f,0,SEEK_END);n=ftell(f);rewind(f);p=malloc((size_t)n);if(!p||fread(p,1,(size_t)n,f)!=(size_t)n){fclose(f);free(p);return NULL;}fclose(f);*size=(size_t)n;return p;
+}
+static uint32_t u32(const unsigned char *p){uint32_t v;memcpy(&v,p,4);return v;}
+int main(int argc,char **argv){
+    unsigned char *a,*b,*pub,*heap;size_t an,bn,pn;uint32_t mask,count=0;struct gs_policy ps[20];
+    struct image image;struct gs_io io;struct gs_resolution r;int st;
+    if(argc!=4){fprintf(stderr,"usage: %s page0 pages1-1024 public-a618\n",argv[0]);return 2;}
+    if(!(a=load(argv[1],&an))||!(b=load(argv[2],&bn))||!(pub=load(argv[3],&pn))||pn<0xcc+20*0x104)return 2;
+    heap=malloc(an+bn);memcpy(heap,a,an);memcpy(heap+an,b,bn);free(a);free(b);mask=u32(pub+4);
+    for(uint32_t i=0;i<20;i++)if(mask&(1U<<i)){
+        const unsigned char *q=pub+0xcc+i*0x104;ps[count]=(struct gs_policy){i,q[4],q[5],q[6],u32(q+12),u32(q+16)};count++;
+    }
+    free(pub);image=(struct image){heap,an+bn};io=(struct gs_io){&image,image_read,an+bn};
+    st=gs_resolve_autonomous(&io,&r);if(st){fprintf(stderr,"autonomous resolve=%d\n",st);return 1;}
+    { struct gs_resolution cross; st=gs_resolve(&io,mask,ps,count,&cross);
+      if(st||cross.va_base!=r.va_base||cross.board_object!=r.board_object||cross.selector!=r.selector||cross.ctgp_tuple!=r.ctgp_tuple){fprintf(stderr,"public cross-check=%d\n",st);return 1;} }
+    printf("va=%llx array=%llx board=%llx selector=%llx ctgp=%llx members=%x/%x/%x/%x writers=%llx/%llx/%llx\n",
+      (unsigned long long)r.va_base,(unsigned long long)r.policy_array,(unsigned long long)r.board_object,
+      (unsigned long long)r.selector,(unsigned long long)r.ctgp_tuple,r.index_member,r.type_member,r.id_member,r.unit_member,
+      (unsigned long long)r.board_max_effective,(unsigned long long)r.board_max_source,(unsigned long long)r.pmgr_upper);
+    free(heap);return 0;
+}
diff --git a/research/test_semantic_resolver.py b/research/test_semantic_resolver.py
new file mode 100644
index 0000000..94a0f09
--- /dev/null
+++ b/research/test_semantic_resolver.py
@@ -0,0 +1,69 @@
+#!/usr/bin/env python3
+from pathlib import Path
+import struct
+import unittest
+
+from semantic_resolver import ResolveError, parse_public_fixture, resolve, resolve_autonomous
+
+ROOT = Path('/home/user/Documents/Codex/2026-09-20/z-x20')
+CAPTURE = ROOT / 'outputs/225w-research/gsp-read-probe-v4/live/20afa6a8-ed42-4d5e-ac15-7a54ca42a9eb'
+
+
+def fixture():
+    heap = ((CAPTURE / 'read-00000000-0001.bin').read_bytes() +
+            (CAPTURE / 'read-00001000-0400.bin').read_bytes())
+    mask, policies = parse_public_fixture((CAPTURE / 'public-a618.bin').read_bytes())
+    return bytearray(heap), mask, policies
+
+
+class ResolverTest(unittest.TestCase):
+    def test_live_capture_has_one_layout(self):
+        heap, mask, policies = fixture()
+        r = resolve_autonomous(heap)
+        cross = resolve(heap, mask, policies)
+        self.assertEqual(r.stock_upper_mw, 175_000)
+        self.assertEqual(r.current_upper_mw, 175_000)
+        self.assertNotEqual(r.va_base, 0)
+        self.assertEqual((r.va_base, r.board_object, r.selector, r.ctgp_tuple),
+                         (cross.va_base, cross.board_object, cross.selector, cross.ctgp_tuple))
+
+    def test_relocated_heap_va(self):
+        heap, mask, policies = fixture()
+        old = resolve_autonomous(heap)
+        delta = 0x4000_0000
+        for off in range(0, len(heap) - 7, 8):
+            value = struct.unpack_from('<Q', heap, off)[0]
+            if old.va_base <= value < old.va_base + len(heap):
+                struct.pack_into('<Q', heap, off, value + delta)
+        new = resolve_autonomous(heap)
+        self.assertEqual(new.va_base, old.va_base + delta)
+        self.assertEqual(new.board_object, old.board_object)
+
+    def test_elevated_values_keep_same_topology(self):
+        heap, _mask, _policies = fixture()
+        old = resolve_autonomous(heap)
+        for off in (old.board_max_effective, old.board_max_source, old.pmgr_upper):
+            struct.pack_into('<I', heap, off, 250_000)
+        new = resolve_autonomous(heap)
+        self.assertEqual((new.va_base, new.board_object, new.selector, new.ctgp_tuple),
+                         (old.va_base, old.board_object, old.selector, old.ctgp_tuple))
+        self.assertEqual(new.current_upper_mw, 250_000)
+
+    def test_corrupt_selector_fails_closed(self):
+        heap, mask, policies = fixture()
+        r = resolve_autonomous(heap)
+        heap[r.selector + 12] = 0
+        with self.assertRaises(ResolveError):
+            resolve_autonomous(heap)
+
+    def test_duplicate_selector_fails_closed(self):
+        heap, mask, policies = fixture()
+        r = resolve_autonomous(heap)
+        duplicate = r.selector + 0x40
+        heap[duplicate:duplicate + 20] = heap[r.selector:r.selector + 20]
+        with self.assertRaises(ResolveError):
+            resolve_autonomous(heap)
+
+
+if __name__ == '__main__':
+    unittest.main()
