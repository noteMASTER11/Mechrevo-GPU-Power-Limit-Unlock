+/* SPDX-License-Identifier: MIT
+ * Fixed 615.71.09 PMGR control layout used by the direct-TGP v7 experiment.
+ * Callers still have to bind the live PMGR object and validate GPU identity.
+ */
+#ifndef CODEX_GSP_DIRECT_TGP_LAYOUT_H
+#define CODEX_GSP_DIRECT_TGP_LAYOUT_H
+#define GSP_DIRECT_TGP_GET_CONTROL 0x2080a61aU
+#define GSP_DIRECT_TGP_SET_CONTROL 0x2080e61bU
+#define GSP_DIRECT_TGP_CONTROL_SIZE 0x3634U
+#define GSP_DIRECT_TGP_MASK ((1U << 2) | (1U << 13) | (1U << 14))
+#define GSP_DIRECT_TGP_ENTRY_BASE 0x14U
+#define GSP_DIRECT_TGP_ENTRY_STRIDE 0xc4U
+static NvU8 *gspDirectTgpEntry(NvU8 *control,NvU32 index)
+{
+ return control+GSP_DIRECT_TGP_ENTRY_BASE+index*GSP_DIRECT_TGP_ENTRY_STRIDE;
+}
+static NvU32 gspDirectTgpGetU32(const NvU8 *p)
+{
+ NvU32 v;portMemCopy(&v,sizeof(v),p,sizeof(v));return v;
+}
+static void gspDirectTgpPutU32(NvU8 *p,NvU32 v)
+{
+ portMemCopy(p,4,&v,4);
+}
+static NV_STATUS gspDirectTgpValidateControl(NvU8 *control,NvU32 baseValue,NvU32 entry13Value,NvU32 entry14Value)
+{
+ NvU8 *e2=gspDirectTgpEntry(control,2),*e13=gspDirectTgpEntry(control,13),*e14=gspDirectTgpEntry(control,14);
+ if(gspDirectTgpGetU32(control+0x10)!=GSP_DIRECT_TGP_MASK ||
+    gspDirectTgpGetU32(e2)!=0 || gspDirectTgpGetU32(e2+4)!=baseValue ||
+    gspDirectTgpGetU32(e13)!=0x12 || gspDirectTgpGetU32(e13+4)!=entry13Value ||
+    gspDirectTgpGetU32(e14)!=0x12 || gspDirectTgpGetU32(e14+4)!=entry14Value)
+  return NV_ERR_INVALID_DATA;
+ return NV_OK;
+}
+static NV_STATUS gspDirectTgpValidateSource(NvU8 *control)
+{
+ NvU8 *e2=gspDirectTgpEntry(control,2),*e13=gspDirectTgpEntry(control,13),*e14=gspDirectTgpEntry(control,14);
+ NvU32 v13=gspDirectTgpGetU32(e13+4),v14=gspDirectTgpGetU32(e14+4);
+ if(gspDirectTgpGetU32(control+0x10)!=GSP_DIRECT_TGP_MASK||
+    gspDirectTgpGetU32(e2)!=0||gspDirectTgpGetU32(e2+4)!=0xffffffffU||
+    gspDirectTgpGetU32(e13)!=0x12||gspDirectTgpGetU32(e14)!=0x12||
+    v13<50000U||v13>400000U||v14<10000U||v14>400000U)
+  return NV_ERR_INVALID_DATA;
+ return NV_OK;
+}
+static void gspDirectTgpPrepareTarget(NvU8 *control,NvU32 targetMw)
+{
+ gspDirectTgpPutU32(gspDirectTgpEntry(control,2)+4,targetMw);
+ gspDirectTgpPutU32(gspDirectTgpEntry(control,13)+4,targetMw);
+ gspDirectTgpPutU32(gspDirectTgpEntry(control,14)+4,targetMw-150000U);
+}
+#endif
