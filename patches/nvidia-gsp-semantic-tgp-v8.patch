@@ -0,0 +1,69 @@
+#!/usr/bin/env python3
+from pathlib import Path
+import struct
+import unittest
+
+from semantic_resolver import ResolveError, parse_public_fixture, resolve, resolve_autonomous
+
+ROOT = Path('/home/user/Documents/Codex/2026-09-20/z-x20')
+CAPTURE = ROOT / 'outputs/225w-research/gsp-read-probe-v4/live/20afa6a8-ed42-4d5e-ac15-7a54ca42a9eb'
+
+
+def fixture():
+    heap = ((CAPTURE / 'read-00000000-0001.bin').read_bytes() +
+            (CAPTURE / 'read-00001000-0400.bin').read_bytes())
+    mask, policies = parse_public_fixture((CAPTURE / 'public-a618.bin').read_bytes())
+    return bytearray(heap), mask, policies
+
+
+class ResolverTest(unittest.TestCase):
+    def test_live_capture_has_one_layout(self):
+        heap, mask, policies = fixture()
+        r = resolve_autonomous(heap)
+        cross = resolve(heap, mask, policies)
+        self.assertEqual(r.stock_upper_mw, 175_000)
+        self.assertEqual(r.current_upper_mw, 175_000)
+        self.assertNotEqual(r.va_base, 0)
+        self.assertEqual((r.va_base, r.board_object, r.selector, r.ctgp_tuple),
+                         (cross.va_base, cross.board_object, cross.selector, cross.ctgp_tuple))
+
+    def test_relocated_heap_va(self):
+        heap, mask, policies = fixture()
+        old = resolve_autonomous(heap)
+        delta = 0x4000_0000
+        for off in range(0, len(heap) - 7, 8):
+            value = struct.unpack_from('<Q', heap, off)[0]
+            if old.va_base <= value < old.va_base + len(heap):
+                struct.pack_into('<Q', heap, off, value + delta)
+        new = resolve_autonomous(heap)
+        self.assertEqual(new.va_base, old.va_base + delta)
+        self.assertEqual(new.board_object, old.board_object)
+
+    def test_elevated_values_keep_same_topology(self):
+        heap, _mask, _policies = fixture()
+        old = resolve_autonomous(heap)
+        for off in (old.board_max_effective, old.board_max_source, old.pmgr_upper):
+            struct.pack_into('<I', heap, off, 250_000)
+        new = resolve_autonomous(heap)
+        self.assertEqual((new.va_base, new.board_object, new.selector, new.ctgp_tuple),
+                         (old.va_base, old.board_object, old.selector, old.ctgp_tuple))
+        self.assertEqual(new.current_upper_mw, 250_000)
+
+    def test_corrupt_selector_fails_closed(self):
+        heap, mask, policies = fixture()
+        r = resolve_autonomous(heap)
+        heap[r.selector + 12] = 0
+        with self.assertRaises(ResolveError):
+            resolve_autonomous(heap)
+
+    def test_duplicate_selector_fails_closed(self):
+        heap, mask, policies = fixture()
+        r = resolve_autonomous(heap)
+        duplicate = r.selector + 0x40
+        heap[duplicate:duplicate + 20] = heap[r.selector:r.selector + 20]
+        with self.assertRaises(ResolveError):
+            resolve_autonomous(heap)
+
+
+if __name__ == '__main__':
+    unittest.main()
