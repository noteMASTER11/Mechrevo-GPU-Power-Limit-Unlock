+/* SPDX-License-Identifier: MIT */
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+typedef uint8_t NvU8;typedef uint32_t NvU32;typedef int NV_STATUS;
+#define NV_OK 0
+#define NV_ERR_INVALID_DATA 1
+#define portMemCopy(d,ds,s,ss) memcpy((d),(s),(ss))
+#include "src/nvidia/interface/deprecated/gsp_direct_tgp_layout.h"
+int main(int argc,char **argv)
+{
+ FILE *f;NvU8 *b;long n;
+ assert(argc==2);f=fopen(argv[1],"rb");assert(f);assert(!fseek(f,0,SEEK_END));n=ftell(f);
+ assert(n==GSP_DIRECT_TGP_CONTROL_SIZE);rewind(f);b=calloc(1,(size_t)n);assert(b);
+ assert(fread(b,1,(size_t)n,f)==(size_t)n);fclose(f);
+ assert(gspDirectTgpValidateControl(b,0xffffffffU,210000U,60000U)==NV_OK);
+ gspDirectTgpPrepareTarget(b);
+ assert(gspDirectTgpValidateControl(b,250000U,250000U,100000U)==NV_OK);
+ assert(gspDirectTgpGetU32(b+0x10)==GSP_DIRECT_TGP_MASK);
+ free(b);puts("direct TGP layout fixture: PASS");return 0;
+}
